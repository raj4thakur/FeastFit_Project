# Copy to .env and edit. Never commit the real .env file.
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./feastfit.db
# DATABASE_URL=postgresql+psycopg://feastfit:feastfit@localhost:5432/feastfit
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
# The account registered with this email becomes an admin (can moderate any recipe)
ADMIN_EMAIL=
# Comma separated origins if a separate frontend needs the API, e.g. http://localhost:5173
CORS_ORIGINS=
